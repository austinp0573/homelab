# copy to .env and edit
# leave a var unset or commented to keep the container image default

# compose / naming
COMPOSE_PROJECT_NAME=tailscale-sidecar
TS_CONTAINER_NAME=tailscale
APP_CONTAINER_NAME=tailscale-app
# TAILSCALE_IMAGE=tailscale/tailscale:latest
# APP_IMAGE=nginx:alpine
RESTART_POLICY=unless-stopped

# host port for the sample app (shared netns with tailscale)
HOST_PORT=8080

# headscale public url. empty = Tailscale SaaS.
# scripts/up.sh turns this into --login-server=... on TS_EXTRA_ARGS
HEADSCALE_URL=

# node name on the tailnet
TS_HOSTNAME=sample-app

# auth key fallback if secrets/authkey.txt is missing
# preferred: put the key in secrets/authkey.txt and leave this empty
TS_AUTHKEY=

# reusable tagged preauth key is what I use for sidecars
# headscale example:
#   headscale preauthkeys create --user <user> --reusable --tags tag:container

# only login when state is empty (named volume keeps identity across restarts)
TS_AUTH_ONCE=true

# false = kernel TUN (default here). true = userspace, no TUN needed but slower
TS_USERSPACE=false

# state path inside the container (named volume mounts here)
TS_STATE_DIR=/var/lib/tailscale

# subnet routes to advertise, comma-separated. empty = none
# TS_ROUTES=192.168.1.0/24

# helpers that scripts/up.sh folds into TS_EXTRA_ARGS
# TS_ADVERTISE_TAGS=tag:container
TS_ADVERTISE_EXIT_NODE=false

# any extra `tailscale up` flags not covered above
# examples: --accept-routes --ssh --advertise-tags=tag:container
TS_EXTRA_ARGS=

# any extra tailscaled flags
# TS_TAILSCALED_EXTRA_ARGS=--verbose=1

# --- optional containerboot knobs (uncomment to set) ---

# TS_ACCEPT_DNS=true
# TS_DEST_IP=
# TS_SOCKS5_SERVER=:1055
# TS_OUTBOUND_HTTP_PROXY_LISTEN=:8080
# TS_SOCKET=/var/run/tailscale/tailscaled.sock
# TS_SERVE_CONFIG=/config/serve.json
# TS_ENABLE_HEALTH_CHECK=true
# TS_ENABLE_METRICS=true
# TS_LOCAL_ADDR_PORT=[::]:9002
# TS_TAILNET_TARGET_IP=
# TS_TAILNET_TARGET_FQDN=

# oauth / workload identity (usually unused here)
# TS_CLIENT_ID=
# TS_CLIENT_SECRET=
# TS_ID_TOKEN=
# TS_AUDIENCE=

# kubernetes only
# TS_KUBE_SECRET=

# experimental
# TS_EXPERIMENTAL_VERSIONED_CONFIG_DIR=
# TS_EXPERIMENTAL_SERVICE_AUTO_ADVERTISEMENT=
