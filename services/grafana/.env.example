# copy to .env and edit

COMPOSE_PROJECT_NAME=grafana
CONTAINER_NAME=grafana
RESTART_POLICY=unless-stopped

# GRAFANA_IMAGE=grafana/grafana:11.6.3

# host network: these bind on the host, not a published port mapping
GF_SERVER_HTTP_ADDR=127.0.0.1
GF_SERVER_HTTP_PORT=3000

# change before first start. grafana only applies admin user/password when
# data/ is empty. after that, change the password in the UI (or reset the db).
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=changeme

# public url once haproxy is in front (placeholder)
GF_SERVER_ROOT_URL=http://127.0.0.1:3000
GF_SERVER_DOMAIN=localhost

GF_USERS_ALLOW_SIGN_UP=false
GF_AUTH_ANONYMOUS_ENABLED=false

# comma-separated plugin ids. empty = none. examples in README.
# GF_INSTALL_PLUGINS=yesoreyeram-infinity-datasource,grafana-clock-panel

DATA_DIR=./data
