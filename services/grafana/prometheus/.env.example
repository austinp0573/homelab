# copy to .env and edit

COMPOSE_PROJECT_NAME=prometheus
CONTAINER_NAME=prometheus
NODE_EXPORTER_CONTAINER_NAME=node-exporter
RESTART_POLICY=unless-stopped

# PROMETHEUS_IMAGE=prom/prometheus:v3.4.2
# NODE_EXPORTER_IMAGE=quay.io/prometheus/node-exporter:v1.9.1

HOST_BIND=127.0.0.1
HOST_PORT=9090
NODE_EXPORTER_HOST_PORT=9100

# how long to keep samples on disk
RETENTION=15d

DATA_DIR=./data
