// alloy ships logs to loki on the same compose network.
// sources below are placeholders - enable what you need.

logging {
  level  = "info"
  format = "logfmt"
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

// example: tail host files (also mount /var/log in compose.yml)
