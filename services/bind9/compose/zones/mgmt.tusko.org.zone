$ORIGIN mgmt.tusko.org.
$TTL 300
@ IN SOA dns-primary.mgmt.tusko.org. hostmaster.tusko.org. (2026101201 300 300 1209600 300)
@ IN NS dns-primary.mgmt.tusko.org.
@ IN NS dns-secondary.mgmt.tusko.org.
dns-primary IN A ${DNS_PRIMARY_IPV4}
dns-secondary IN A ${DNS_SECONDARY_IPV4}
pve-01 IN A 10.0.10.21
pve-02 IN A 10.0.10.22
pve-03 IN A 10.0.10.23
