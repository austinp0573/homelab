# copy to .env and edit

COMPOSE_PROJECT_NAME=kasm
CONTAINER_NAME=kasm
RESTART_POLICY=unless-stopped

# pinned to current desktop release. swap tag later when you care.
# KASM_IMAGE=kasmweb/desktop:1.19.0

# bind localhost when a reverse proxy is on the same host
HOST_BIND=127.0.0.1
HOST_PORT=6901

# host dir mounted to /home/kasm-user/Downloads inside the container
DATA_DIR=./data

# chrome / electron apps need a decent /dev/shm. kasm docs say 512m; 1gb is safer.
SHM_SIZE=1gb
