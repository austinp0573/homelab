# copy to .env and edit

COMPOSE_PROJECT_NAME=sidecar-nginx
RESTART_POLICY=unless-stopped

# NGINX_IMAGE=nginx:alpine
NGINX_CONTAINER_NAME=sidecar-nginx
PLACEHOLDER_CONTAINER_NAME=sidecar-placeholder

# bind localhost when haproxy (or another proxy) is on the same host
HOST_BIND=127.0.0.1
HOST_PORT=8080

# which conf the sidecar loads. swap this to try patterns under config/
NGINX_CONF=./config/proxy/nginx.conf

# COMPOSE_CMD=nerdctl compose
