AUTHELIA_IMAGE=authelia/authelia:latest
CONTAINER_NAME=authelia
RESTART_POLICY=unless-stopped
HOST_BIND=127.0.0.1
HOST_PORT=9091
CONTAINER_PORT=9091
TIME_ZONE=America/Chicago
AUTH_NTFY_NET=<NET_NAME>

# Secrets (generate each using: openssl rand -hex 32)
AUTHELIA_JWT_SECRET=change_me_generate_with_openssl_rand_hex_32
AUTHELIA_SESSION_SECRET=change_me_generate_with_openssl_rand_hex_32
AUTHELIA_STORAGE_ENCRYPTION_KEY=change_me_generate_with_openssl_rand_hex_32

# Admin User Credentials
AUTH_ADMIN_DISPLAYNAME=austin
AUTH_ADMIN_PASSWORD=<hashed_password>
AUTH_ADMIN_EMAIL=
