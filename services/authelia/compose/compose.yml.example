services:
  authelia:
    image: ${AUTHELIA_IMAGE:-authelia/authelia:4.39}
    container_name: ${CONTAINER_NAME:-authelia}
    volumes:
      - ./config:/config
    restart: ${RESTART_POLICY:-unless-stopped}
    ports:
      - "${HOST_BIND:-127.0.0.1}:${HOST_PORT:-9091}:${CONTAINER_PORT:-9091}"
    healthcheck:
      test: ["CMD-SHELL", "authelia healthcheck || exit 1"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 20s
    environment:
      TZ: ${TIME_ZONE:-America/Chicago}
      AUTHELIA_IDENTITY_VALIDATION_RESET_PASSWORD_JWT_SECRET: ${AUTHELIA_JWT_SECRET}
      AUTHELIA_SESSION_SECRET: ${AUTHELIA_SESSION_SECRET}
      AUTHELIA_STORAGE_ENCRYPTION_KEY: ${AUTHELIA_STORAGE_ENCRYPTION_KEY}
    networks:
      - internal_net

networks:
  internal_net:
    name: ${AUTH_NTFY_NET:-vps-03-internal_net}
    external: true
