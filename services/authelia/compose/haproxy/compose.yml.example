services:
  haproxy:
    build: .
    image: haproxy-authelia:local
    container_name: haproxy
    restart: unless-stopped
    network_mode: host
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    volumes:
      - ./config:/usr/local/etc/haproxy:ro
