# Match these to the host account that owns /opt/pi-agent.
PUID=1000
PGID=1000

# Used only to give the project a stable path inside the container.
PROJECT_SLUG=project

# Optional API-key providers.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Optional. Normal pi-exa web search/fetch does not require this.
# Required only if you deliberately enable Exa paid/deep-search features.
EXA_API_KEY=
