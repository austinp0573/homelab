# copy to .env and edit

COMPOSE_PROJECT_NAME=ntfy
CONTAINER_NAME=ntfy
RESTART_POLICY=unless-stopped
# NTFY_IMAGE=binwiederhier/ntfy:v2.14.0

TZ=UTC

# public URL (must match config/server.yml base-url)
BASE_URL=https://ntfy.example.com

# edge VPS (haproxy on same host): keep 127.0.0.1
# home lab (edge reaches you over headscale): use 0.0.0.0 so the tailnet IP accepts connections
HOST_BIND=127.0.0.1
HOST_PORT=2586

DATA_DIR=./data
CACHE_DIR=./cache

# used by bootstrap-admin.sh
NTFY_ADMIN_USER=admin
