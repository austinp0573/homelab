NETBOX_VERSION=v4.7.2-5.1.1

NETBOX_BIND_ADDRESS=0.0.0.0
NETBOX_PORT=8000

# lock this down to your netbox fqdn once dns is configured.
NETBOX_ALLOWED_HOSTS=*

# example once netbox is behind https:
# NETBOX_CSRF_TRUSTED_ORIGINS=https://netbox.example.com
NETBOX_CSRF_TRUSTED_ORIGINS=

POSTGRES_PASSWORD=CHANGE_ME

REDIS_PASSWORD=CHANGE_ME
REDIS_CACHE_PASSWORD=CHANGE_ME

NETBOX_SECRET_KEY=CHANGE_ME
NETBOX_API_TOKEN_PEPPER_1=CHANGE_ME
