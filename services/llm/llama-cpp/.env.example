# copy to .env and edit

COMPOSE_PROJECT_NAME=llm-llama-cpp
CONTAINER_NAME=llama-cpp
RESTART_POLICY=unless-stopped

LLAMA_IMAGE=ghcr.io/ggml-org/llama.cpp:server-rocm
LLM_NETWORK=llm-backend

# Keep the API off the LAN. Open WebUI reaches it on LLM_NETWORK.
HOST_BIND=127.0.0.1
HOST_PORT=8080

MODELS_DIR=/opt/llm/models

# filename only, must exist under MODELS_DIR
MODEL_FILE=Qwen3-32B-Q4_K_M.gguf

CTX_SIZE=8192
N_GPU_LAYERS=999
HIP_VISIBLE_DEVICES=0

# Leave empty unless rocminfo and a failed start show that it is needed.
HSA_OVERRIDE_GFX_VERSION=
