# copy to .env and edit

COMPOSE_PROJECT_NAME=llm-speech
RESTART_POLICY=unless-stopped

WHISPER_CONTAINER_NAME=llm-whisper
PIPER_CONTAINER_NAME=llm-piper

WHISPER_BIND=127.0.0.1
WHISPER_HOST_PORT=9000
PIPER_BIND=127.0.0.1
PIPER_HOST_PORT=10200

WHISPER_CACHE_DIR=/opt/llm/whisper
TTS_DIR=/opt/llm/tts

WHISPER_MODEL=medium
WHISPER_DEVICE=cuda
WHISPER_MAX_UPLOAD_MB=200

ROCM_PYTORCH_IMAGE=rocm/pytorch:rocm7.2.3_ubuntu24.04_py3.12_pytorch_release_2.9.1
WHISPER_IMAGE=local/llm-whisper-rocm:latest

PIPER_IMAGE=rhasspy/wyoming-piper:2.2.2
PIPER_VOICE=en_US-lessac-medium

HIP_VISIBLE_DEVICES=0
HSA_OVERRIDE_GFX_VERSION=
