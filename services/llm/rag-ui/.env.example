# copy to .env and edit

COMPOSE_PROJECT_NAME=llm-rag-ui
CONTAINER_NAME=llm-anythingllm
RESTART_POLICY=unless-stopped
LLM_NETWORK=llm-backend
HOST_BIND=127.0.0.1
HOST_PORT=3001

ANYTHINGLLM_IMAGE=mintplexlabs/anythingllm:1.11.1

DOCS_DIR=/opt/llm/rag/docs

LLM_PROVIDER=generic-openai
GENERIC_OPEN_AI_BASE_PATH=http://llama-cpp:8080/v1
GENERIC_OPEN_AI_API_KEY=local
GENERIC_OPEN_AI_MODEL_PREF=local-model
GENERIC_OPEN_AI_MODEL_TOKEN_LIMIT=8192
