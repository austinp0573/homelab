COMPOSE_PROJECT_NAME=llm-ebook2audiobook
CONTAINER_NAME=ebook2audiobook
RESTART_POLICY=no

EBOOK_IMAGE=athomasson2/ebook2audiobook:rocm
EBOOK_BIND=127.0.0.1
EBOOK_PORT=7860

EBOOKS_DIR=/opt/llm/ebooks
AUDIOBOOKS_DIR=/opt/llm/audiobooks
MODELS_DIR=/opt/llm/ebook-models
VOICES_DIR=/opt/llm/ebook-voices
TMP_DIR=/opt/llm/ebook-tmp
EBOOK_LANGUAGE=eng

HIP_VISIBLE_DEVICES=0
HSA_OVERRIDE_GFX_VERSION=
