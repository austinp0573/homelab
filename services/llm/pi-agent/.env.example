# copy to .env and edit

COMPOSE_PROJECT_NAME=llm-pi-agent
CONTAINER_NAME=llm-pi
# PI_IMAGE=local/llm-pi-agent:latest

# overridden by scripts/run.sh
PROJECT_DIR=.

# dummy key; llama.cpp does not check it
OPENAI_API_KEY=local

# used by smoke helpers / docs; models.json is the real config for pi
LLAMA_BASE_URL=http://host.docker.internal:8080/v1
