# copy to .env and edit

COMPOSE_PROJECT_NAME=llm-rag-headless
RESTART_POLICY=unless-stopped

QDRANT_CONTAINER_NAME=llm-qdrant
EMBED_CONTAINER_NAME=llm-embed

LLM_NETWORK=llm-backend
QDRANT_BIND=127.0.0.1
QDRANT_HOST_PORT=6333
QDRANT_GRPC_PORT=6334
EMBED_BIND=127.0.0.1
EMBED_HOST_PORT=8081

QDRANT_IMAGE=qdrant/qdrant:v1.13.2
EMBED_IMAGE=ghcr.io/ggml-org/llama.cpp:server

MODELS_DIR=/opt/llm/models
QDRANT_DATA_DIR=/opt/llm/rag/qdrant
DOCS_DIR=/opt/llm/rag/docs

EMBED_MODEL_FILE=nomic-embed-text-v1.5.Q8_0.gguf
EMBED_CTX_SIZE=2048
EMBED_THREADS=8

QDRANT_COLLECTION=lab
EMBED_VECTOR_SIZE=768
CHUNK_SIZE=800
CHUNK_OVERLAP=100
