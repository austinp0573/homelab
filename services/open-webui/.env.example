COMPOSE_PROJECT_NAME=open-webui
CONTAINER_NAME=open-webui
RESTART_POLICY=unless-stopped

OPEN_WEBUI_IMAGE=ghcr.io/open-webui/open-webui:v0.10.2
LLM_NETWORK=llm-backend

# Keep this on loopback unless the host firewall limits LAN access.
WEBUI_BIND=127.0.0.1
WEBUI_PORT=3000

OPENWEBUI_API_BASE_URL=http://llama-cpp:8080/v1
OPENWEBUI_API_KEY=local

WEBUI_AUTH=True
# Set to False after the first admin account exists.
ENABLE_SIGNUP=True
WEBUI_SECRET_KEY=replace-with-a-random-secret

QDRANT_URI=http://llm-qdrant:6333
RAG_OPENAI_API_BASE_URL=http://llm-embed:8080/v1
RAG_OPENAI_API_KEY=local
RAG_EMBEDDING_MODEL=nomic-embed-text-v1.5.Q8_0.gguf
RAG_EMBEDDING_BATCH_SIZE=8
