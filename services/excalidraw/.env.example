# copy to .env and edit

COMPOSE_PROJECT_NAME=excalidraw
EXCALIDRAW_CONTAINER_NAME=excalidraw
ROOM_CONTAINER_NAME=excalidraw-room
AUTH_CONTAINER_NAME=excalidraw-auth
RESTART_POLICY=unless-stopped

# EXCALIDRAW_IMAGE=excalidraw/excalidraw:latest
# ROOM_IMAGE=excalidraw/excalidraw-room:latest
# AUTH_IMAGE=nginx:1.27-alpine

# bind localhost by default. for tailnet, either:
#   - put a reverse proxy on this host and keep 127.0.0.1 here, or
#   - bind the tailnet IP / 0.0.0.0 and firewall accordingly
HOST_BIND=127.0.0.1
UI_HOST_PORT=5000
ROOM_HOST_PORT=5001
AUTH_HOST_PORT=5002

# public https names your reverse proxy will use (placeholders)
# ui:     https://draw.private.example.com
# collab: https://collab.private.example.com
VITE_APP_WS_SERVER_URL=https://collab.private.example.com
CORS_ORIGIN=https://draw.private.example.com

# set to y and run ./scripts/htpasswd.sh before up
ENABLE_BASIC_AUTH=n
