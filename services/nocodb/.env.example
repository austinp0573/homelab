# copy to .env and edit

COMPOSE_PROJECT_NAME=nocodb
CONTAINER_NAME=nocodb
RESTART_POLICY=unless-stopped

# NOCODB_IMAGE=nocodb/nocodb:latest

# bind localhost when haproxy (or another proxy) is on the same host
# use 0.0.0.0 only if you intentionally expose the port on the LAN
HOST_BIND=127.0.0.1
HOST_PORT=8789

DATA_DIR=./data

# required for stable logins across restarts
# generate with: openssl rand -base64 32
NC_AUTH_JWT_SECRET=change-me

# public https url your reverse proxy will use (share links, invites, swagger)
NC_SITE_URL=https://nocodb.private.example.com
