# copy to .env and edit

COMPOSE_PROJECT_NAME=gatus
CONTAINER_NAME=gatus
RESTART_POLICY=unless-stopped

# GATUS_IMAGE=ghcr.io/twin/gatus:v5.35.0

# bind localhost when haproxy (or another proxy) is on the same host
# use 0.0.0.0 only if you intentionally expose the port on the LAN
HOST_BIND=127.0.0.1
HOST_PORT=8080

DATA_DIR=./data

# basic auth username written into config/10-security.yaml by hash-password.sh
GATUS_AUTH_USER=admin
