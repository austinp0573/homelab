# host settings
HOST_ROOT=/
# host name identifier for restic snapshots
RESTIC_HOST=vm6

TZ=America/Chicago
# (debug, info, warn, error)
LOG_LEVEL=info

# restic settings

# resticprofile_global_environment
# default password file path inside container
RESTIC_PASSWORD_FILE=/run/secrets/password.txt
# host machine local backup directory mounted into container
LOCAL_BACKUP_HOST_PATH=/var/backups/restic
# local disk backup base directory inside container
LOCAL_BACKUP_PATH=/local-backups

# rest server
# restic-rest-api endpoint url
# LEAVE OUT THE TRAILING /
REST_URL=rest:https://restic.example.com:8000
# RESTIC_REST_PASSWORD in /secrets/rest_secrets.env
RESTIC_REST_USERNAME=rest_user

# s3 compatible
## AWS_ACCESS_KEY_ID in secrets/s3_secrets.env
## AWS_SECRET_ACCESS_KEY in secrets/s3_secrets.env
# bucket repository url prefix
# S3_BUCKET_URL=s3:https://<account-id>.r2.cloudflarestorage.com/homelab-backups

# sftp
# SFTP_HOST=sftp.example.com
# SFTP_USER=backup-user
# sftp remote root backup directory
# SFTP_PATH=/srv/backups
# ssh host alias defined in /root/.ssh/config
# SFTP_HOST_ALIAS=vps1

# ntfy
# NTFY_URL=https://ntfy.sh
# topic name
# NTFY_TOPIC=homelab-backups
# optional healthchecks ping url
# HEALTHCHECKS_URL=https://hc-ping.com/uuid-here

# staging scripts
# application file staging source directory
# SRC_DIR=/host/opt/app-dir/data
# application staging destination directory
# STAGING_DIR=/staging/app-backup/
# VERIFY PRIOR TO DEPLOYMENT
# RSYNC_EXTRA_ARGS="--exclude=*.db --exclude=*.db-wal --exclude=*.db-shm"
# sqlite database file source path
# SQLITE_DB=/host/opt/app-dir/data/app.db
# sqlite temporary directory inside the staging bind mount
# SQLITE_TMP_DIR=/staging/.sqlite-tmp
# sqlite staged database file name
# STAGING_DB_NAME=app-backup.db
# sqlite backup timeout in milliseconds
# BUSY_TIMEOUT=30000 # (30s)

# MUST RUN for app/sqlite
## sudo mkdir -p \
##    /opt/resticprofile/staging/vaultwarden \
##    /opt/resticprofile/staging/.sqlite-tmp