# copy to .env and edit

COMPOSE_PROJECT_NAME=caddy
CONTAINER_NAME=caddy
RESTART_POLICY=unless-stopped

# CADDY_IMAGE=caddy:alpine

# 0.0.0.0 for a real edge listener. 127.0.0.1 if something else terminates in front.
HOST_BIND=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443

DATA_DIR=./data
CONFIG_DIR=./config

# optional override if nerdctl/docker compose is not on PATH the usual way
# COMPOSE_CMD=nerdctl compose
