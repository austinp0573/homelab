# localhost goaccess for caddy stats UI

https://stats.{$ROOT_DOMAIN} {
	import logging
	import common_headers
	import tls_cloudflare
	import crowdsec_bouncer
	route {
		authorize with mypolicy

		handle /ws {
			reverse_proxy 127.0.0.1:7890 {
				health_uri /
				health_status 400
				health_interval 30s
				health_timeout 10s
			}
		}

		handle {
			root * /data
			try_files {path} /stats.html
			file_server
		}
	}
}
