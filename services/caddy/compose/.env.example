ROOT_DOMAIN=example.com
CERT_PATH=/etc/caddy/certs/fullchain.pem
KEY_PATH=/etc/caddy/certs/privkey.pem
JWT_SECRET=your_secret_jwt_key # openssl rand -hex 32
CLOUDFLARE_API_TOKEN=your_cloudflare_token
TZ=America/Chicago
CADDY_SECURITY_USERNAME=webadmin
CADDY_SECURITY_PASSWORD=your_secure_password
CADDY_SECURITY_ADMIN_NAME=Admin
CADDY_SECURITY_ADMIN_EMAIL=admin@example.com
CADDY_AUTHDB_USERNAME=authdbctl-user
CADDY_AUTHDB_PASSWORD=your_60_char_random_password
CROWDSEC_API_URL=http://127.0.0.1:8080/
CROWDSEC_API_KEY=your_crowdsec_api_key

# Backend Targets
GATUS_BACKEND=
NTFY_BACKEND=
RESTIC_BACKEND=
TS_HEALTH_BACKEND=
NGINX_BACKEND=
PATIENCE_BACKEND=
# APP_BACKEND=127.0.0.1:8091
STATS_WS_BACKEND=
