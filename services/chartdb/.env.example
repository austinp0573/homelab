# copy to .env and edit

COMPOSE_PROJECT_NAME=chartdb
CHARTDB_CONTAINER_NAME=chartdb
AUTH_CONTAINER_NAME=chartdb-auth
RESTART_POLICY=unless-stopped

# floating latest; override if you want a digest or tag pin
# CHARTDB_IMAGE=ghcr.io/chartdb/chartdb:latest
# AUTH_IMAGE=nginx:1.27-alpine

# bind localhost by default. for tailnet, either:
#   - put a reverse proxy on this host and keep 127.0.0.1 here, or
#   - bind the tailnet IP / 0.0.0.0 and firewall accordingly
HOST_BIND=127.0.0.1
HOST_PORT=8792
AUTH_HOST_PORT=8793

# analytics off
DISABLE_ANALYTICS=true

# optional: hide ChartDB cloud upsell in the UI
# HIDE_CHARTDB_CLOUD=true

# optional AI (DDL export). leave blank, or set ONE option — do not mix.
# option 1: OpenAI
# OPENAI_API_KEY=
# option 2: OpenAI-compatible endpoint + model
# OPENAI_API_ENDPOINT=
# LLM_MODEL_NAME=

# public https name your reverse proxy will use (placeholder)
# ui: https://chartdb.private.example.com
