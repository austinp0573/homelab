# copy this file to .env and edit it

# compose project namespace
COMPOSE_PROJECT_NAME=borgmatic-template

# hostname visible inside the container
CLIENT_HOSTNAME=template-host

# backup set name, usually repo name
BACKUP_NAME=template-host

# container timezone
TZ=America/Chicago

# runtime user id inside the image
PUID=0

# runtime group id inside the image
PGID=0

# borgmatic container image
BORGMATIC_IMAGE=ghcr.io/borgmatic-collective/borgmatic:latest

# compose restart policy
RESTART_POLICY=no

# borgmatic log level
BORGMATIC_VERBOSITY=1

# truenas ssh host
TRUENAS_HOST=10.0.0.1

# ssh user on truenas
BORG_REMOTE_USER=borg-user

# ssh port on truenas
BORG_REMOTE_PORT=22

# stable repo path on truenas
BORG_REMOTE_REPO_PATH=/mnt/coldpool/borg/lab/sample-host

# borgmatic label for the remote repo
BORG_REMOTE_REPOSITORY_LABEL=truenas

# repo path inside the container
BORG_LOCAL_REPO_PATH=/backup/repositories/sample-host

# borgmatic label for the local repo
BORG_LOCAL_REPOSITORY_LABEL=local

# host path mounted as source root
HOST_ROOT=/

# optional app data path
APP_DATA_PATH=/srv/example-app

# host path for local repos
LOCAL_REPO_ROOT=./local-repositories

# borg encryption mode
BORG_ENCRYPTION=repokey-blake2

# borg compression setting
BORG_COMPRESSION=auto,zstd,6

# passphrase file path inside the container
BORG_PASSPHRASE_FILE=/secrets/passphrase.txt

# archive name prefix, usually backup name
ARCHIVE_NAME_FORMAT=template-host

# private key path inside the container
BORG_SSH_KEY_FILE=/secrets/ssh/id_ed25519

# known hosts path inside the container
BORG_KNOWN_HOSTS_FILE=/secrets/ssh/known_hosts

# ssh command used by borg
BORG_SSH_COMMAND=ssh -i /secrets/ssh/id_ed25519 -o UserKnownHostsFile=/dev/null -o StrictHostKeyChecking=no -o IdentitiesOnly=yes

# sleep time for scheduled profile
SCHEDULE_SECONDS=86400

# healthchecks ping url
HEALTHCHECKS_PING_URL=https://hc-ping.com/replace-me

# ntfy server url
NTFY_SERVER=https://ntfy.example.test

# ntfy topic
NTFY_TOPIC=borgmatic-sample

# ntfy access token
NTFY_ACCESS_TOKEN=replace-me

# apprise service url
APPRISE_URL=gotify://example.test/token
