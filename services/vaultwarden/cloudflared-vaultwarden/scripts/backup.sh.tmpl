#!/bin/sh

# deps, find mkdir mktemp tar zstd sqlite3 hostname date cp mv rm kill
# optional deps, age curl rclone
# configuration, hydrated by envsubst
DATA_DIR="${DATA_DIR}"
APP_NAME="${APP_NAME}"
BACKUP_DEST_TYPE="${BACKUP_DEST_TYPE}"
RCLONE_REMOTE="${RCLONE_REMOTE}"
LOCAL_DEST_DIR="${LOCAL_DEST_DIR}"
COMPRESSION_TYPE="${COMPRESSION_TYPE}"
ZSTD_FLAGS="${ZSTD_FLAGS}"
ENCRYPT_BACKUP="${ENCRYPT_BACKUP}"
ENCRYPTION_TYPE="${ENCRYPTION_TYPE}"
AGE_PUBLIC_KEY="${AGE_PUBLIC_KEY}"
HEALTHCHECKS_URL="${HEALTHCHECKS_URL}"
REMOTE_RETENTION_ENABLED="${REMOTE_RETENTION_ENABLED}"
RETENTION_DAYS="${RETENTION_DAYS}"
EXCLUDE_PATTERNS="${EXCLUDE_PATTERNS}"
LOCK_ENABLED="${LOCK_ENABLED}"
LOCK_DIR="${LOCK_DIR}"

HOSTNAME_VALUE=""
TIMESTAMP_VALUE=""
BASE_NAME=""
TAR_ARCHIVE=""
COMPRESSED_ARCHIVE=""
COMPRESSED_ARCHIVE_NAME=""
FINAL_ARCHIVE=""
FINAL_ARCHIVE_NAME=""
WORK_DIR=""
STAGING_DIR=""
LOCK_HELD="no"

log() {
    printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*"
}

notify_success() {
    if [ -z "$HEALTHCHECKS_URL" ]; then
        return 0
    fi

    curl -fsS --retry 3 "$HEALTHCHECKS_URL" >/dev/null 2>&1 || log "warning, success notification failed"
}

notify_failure() {
    if [ -z "$HEALTHCHECKS_URL" ]; then
        return 0
    fi

    curl -fsS --retry 3 "$HEALTHCHECKS_URL/fail" >/dev/null 2>&1 || log "warning, failure notification failed"
}

cleanup() {
    if [ -n "$WORK_DIR" ]; then
        rm -rf "$WORK_DIR"
    fi

    if [ "$LOCK_ENABLED" = "yes" ] && [ "$LOCK_HELD" = "yes" ] && [ -n "$LOCK_DIR" ]; then
        rm -rf "$LOCK_DIR"
    fi
}

fail() {
    log "error, $*"
    notify_failure
    exit 1
}

on_signal() {
    fail "backup interrupted"
}

require_value() {
    value_name=$1
    value_data=$2

    if [ -z "$value_data" ]; then
        fail "$value_name is required"
    fi
}

is_number() {
    case "$1" in
        ''|*[!0123456789]*)
            return 1
            ;;
        *)
            return 0
            ;;
    esac
}

check_commands() {
    required_commands="find mkdir mktemp tar sqlite3 hostname date cp mv rm"

    if [ "$LOCK_ENABLED" = "yes" ]; then
        required_commands="$required_commands kill"
    fi

    case "$COMPRESSION_TYPE" in
        zstd)
            required_commands="$required_commands zstd"
            ;;
    esac

    case "$ENCRYPT_BACKUP" in
        yes)
            case "$ENCRYPTION_TYPE" in
                age)
                    required_commands="$required_commands age"
                    ;;
            esac
            ;;
    esac

    if [ -n "$HEALTHCHECKS_URL" ]; then
        required_commands="$required_commands curl"
    fi

    if [ "$BACKUP_DEST_TYPE" = "r2" ]; then
        required_commands="$required_commands rclone"
    fi

    missing_commands=""

    for command_name in $required_commands; do
        if ! command -v "$command_name" >/dev/null 2>&1; then
            missing_commands="$missing_commands $command_name"
        fi
    done

    if [ -n "$missing_commands" ]; then
        fail "missing required tools, $missing_commands"
    fi
}

validate_config() {
    require_value "DATA_DIR" "$DATA_DIR"
    require_value "APP_NAME" "$APP_NAME"
    require_value "BACKUP_DEST_TYPE" "$BACKUP_DEST_TYPE"

    DATA_DIR=${DATA_DIR%/}

    if [ -z "$COMPRESSION_TYPE" ]; then
        COMPRESSION_TYPE="zstd"
    fi

    if [ -z "$ZSTD_FLAGS" ]; then
        ZSTD_FLAGS="-10"
    fi

    if [ -z "$ENCRYPT_BACKUP" ]; then
        ENCRYPT_BACKUP="yes"
    fi

    if [ -z "$ENCRYPTION_TYPE" ]; then
        ENCRYPTION_TYPE="age"
    fi

    if [ -z "$REMOTE_RETENTION_ENABLED" ]; then
        REMOTE_RETENTION_ENABLED="no"
    fi

    if [ -z "$LOCK_ENABLED" ]; then
        LOCK_ENABLED="yes"
    fi

    case "$DATA_DIR" in
        /*)
            ;;
        *)
            fail "DATA_DIR must be absolute"
            ;;
    esac

    if [ "$DATA_DIR" = "" ] || [ "$DATA_DIR" = "/" ]; then
        fail "DATA_DIR must point to an app data directory"
    fi

    case "$APP_NAME" in
        *[!abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._-]*)
            fail "APP_NAME may only contain letters numbers dot underscore and dash"
            ;;
    esac

    case "$COMPRESSION_TYPE" in
        zstd)
            ;;
        *)
            fail "COMPRESSION_TYPE must be zstd"
            ;;
    esac

    case "$ENCRYPT_BACKUP" in
        yes|no)
            ;;
        *)
            fail "ENCRYPT_BACKUP must be yes or no"
            ;;
    esac

    case "$ENCRYPTION_TYPE" in
        age)
            ;;
        *)
            fail "ENCRYPTION_TYPE must be age"
            ;;
    esac

    if [ "$ENCRYPT_BACKUP" = "yes" ]; then
        case "$ENCRYPTION_TYPE" in
            age)
                require_value "AGE_PUBLIC_KEY" "$AGE_PUBLIC_KEY"
                ;;
        esac
    fi

    case "$REMOTE_RETENTION_ENABLED" in
        yes|no)
            ;;
        *)
            fail "REMOTE_RETENTION_ENABLED must be yes or no"
            ;;
    esac

    case "$LOCK_ENABLED" in
        yes|no)
            ;;
        *)
            fail "LOCK_ENABLED must be yes or no"
            ;;
    esac

    if [ ! -d "$DATA_DIR" ]; then
        fail "DATA_DIR does not exist, $DATA_DIR"
    fi

    if [ ! -r "$DATA_DIR" ]; then
        fail "DATA_DIR is not readable, $DATA_DIR"
    fi

    case "$BACKUP_DEST_TYPE" in
        r2)
            require_value "RCLONE_REMOTE" "$RCLONE_REMOTE"
            if [ "$REMOTE_RETENTION_ENABLED" = "yes" ]; then
                require_value "RETENTION_DAYS" "$RETENTION_DAYS"
                is_number "$RETENTION_DAYS" || fail "RETENTION_DAYS must be a number"
            fi
            ;;
        local)
            require_value "LOCAL_DEST_DIR" "$LOCAL_DEST_DIR"
            case "$LOCAL_DEST_DIR" in
                /*)
                    ;;
                *)
                    fail "LOCAL_DEST_DIR must be absolute"
                    ;;
            esac
            ;;
        *)
            fail "BACKUP_DEST_TYPE must be r2 or local"
            ;;
    esac

    if [ "$LOCK_ENABLED" = "yes" ] && [ -z "$LOCK_DIR" ]; then
        LOCK_DIR="/tmp/$APP_NAME-backup.lock"
    fi
}

acquire_lock() {
    if [ "$LOCK_ENABLED" != "yes" ]; then
        log "backup lock disabled"
        return 0
    fi

    if mkdir "$LOCK_DIR" 2>/dev/null; then
        LOCK_HELD="yes"
        printf '%s\n' "$$" > "$LOCK_DIR/pid" || fail "could not write lock pid"
        return 0
    fi

    old_pid=""
    if [ -f "$LOCK_DIR/pid" ]; then
        IFS= read -r old_pid < "$LOCK_DIR/pid"
    fi

    if [ -n "$old_pid" ] && kill -0 "$old_pid" 2>/dev/null; then
        log "another backup is already running, exiting"
        exit 0
    fi

    log "removing stale backup lock"
    rm -rf "$LOCK_DIR" || fail "could not remove stale lock"
    mkdir "$LOCK_DIR" || fail "could not create lock"
    LOCK_HELD="yes"
    printf '%s\n' "$$" > "$LOCK_DIR/pid" || fail "could not write lock pid"
}

prepare_work_dirs() {
    WORK_DIR=$(mktemp -d "/tmp/$APP_NAME-backup.XXXXXX") || fail "could not create work directory"
    trap cleanup EXIT
    trap on_signal INT TERM

    STAGING_DIR="$WORK_DIR/staging"
    mkdir -p "$STAGING_DIR" || fail "could not create staging directory"
}

is_excluded() {
    rel_path=$1

    for exclude_pattern in $EXCLUDE_PATTERNS; do
        case "$rel_path" in
            $exclude_pattern|$exclude_pattern/*)
                return 0
                ;;
        esac
    done

    return 1
}

is_sqlite_sidecar() {
    case "$1" in
        *.db-wal|*.db-shm|*.db-journal|*.db3-wal|*.db3-shm|*.db3-journal|*.sqlite-wal|*.sqlite-shm|*.sqlite-journal|*.sqlite3-wal|*.sqlite3-shm|*.sqlite3-journal)
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

is_sqlite_candidate() {
    case "$1" in
        *.db|*.db3|*.sqlite|*.sqlite3)
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

make_parent_dir() {
    rel_path=$1
    parent_path=${rel_path%/*}

    if [ "$parent_path" != "$rel_path" ]; then
        mkdir -p "$STAGING_DIR/$parent_path" || return 1
    fi

    return 0
}

copy_regular_file() {
    src_path=$1
    rel_path=$2
    dest_path="$STAGING_DIR/$rel_path"

    make_parent_dir "$rel_path" || fail "could not create parent directory for $rel_path"
    cp -p "$src_path" "$dest_path" || fail "could not copy $rel_path"
}

copy_sqlite_file() {
    src_path=$1
    rel_path=$2
    dest_path="$STAGING_DIR/$rel_path"

    check_output=$(sqlite3 "$src_path" "PRAGMA quick_check;" 2>&1)
    check_status=$?

    if [ "$check_status" -ne 0 ]; then
        case "$check_output" in
            *"file is not a database"*|*"unsupported file format"*)
                log "copying non sqlite file with sqlite extension, $rel_path"
                copy_regular_file "$src_path" "$rel_path"
                return 0
                ;;
            *)
                fail "sqlite check failed for $rel_path"
                ;;
        esac
    fi

    if [ "$check_output" != "ok" ]; then
        fail "sqlite quick check failed for $rel_path"
    fi

    case "$dest_path" in
        *"'"*)
            fail "sqlite backup path contains unsupported quote, $rel_path"
            ;;
    esac

    make_parent_dir "$rel_path" || fail "could not create parent directory for $rel_path"
    sqlite3 "$src_path" ".timeout 10000" ".backup '$dest_path'" || fail "sqlite backup failed for $rel_path"
}

stage_data() {
    log "staging data from $DATA_DIR"
    file_list="$WORK_DIR/file-list"

    find "$DATA_DIR" -type f > "$file_list" || fail "could not list data files"

    while IFS= read -r src_path; do
        case "$src_path" in
            "$DATA_DIR"/*)
                rel_path=${src_path#"$DATA_DIR"/}
                ;;
            *)
                fail "found file outside data directory, $src_path"
                ;;
        esac

        if is_excluded "$rel_path"; then
            log "skipping excluded path, $rel_path"
            continue
        fi

        if is_sqlite_sidecar "$rel_path"; then
            log "skipping sqlite sidecar, $rel_path"
            continue
        fi

        if is_sqlite_candidate "$rel_path"; then
            log "backing up sqlite candidate, $rel_path"
            copy_sqlite_file "$src_path" "$rel_path"
        else
            copy_regular_file "$src_path" "$rel_path"
        fi
    done < "$file_list"
}

set_archive_names() {
    HOSTNAME_VALUE=$(hostname) || fail "could not read hostname"
    TIMESTAMP_VALUE=$(date '+%Y-%m-%d-%H%M') || fail "could not read timestamp"
    BASE_NAME="$HOSTNAME_VALUE-$APP_NAME-$TIMESTAMP_VALUE"
    TAR_ARCHIVE="$WORK_DIR/$BASE_NAME.tar"

    case "$COMPRESSION_TYPE" in
        zstd)
            COMPRESSED_ARCHIVE_NAME="$BASE_NAME.tar.zst"
            ;;
        *)
            fail "unknown compression type"
            ;;
    esac

    COMPRESSED_ARCHIVE="$WORK_DIR/$COMPRESSED_ARCHIVE_NAME"

    case "$ENCRYPT_BACKUP" in
        yes)
            case "$ENCRYPTION_TYPE" in
                age)
                    FINAL_ARCHIVE_NAME="$COMPRESSED_ARCHIVE_NAME.age"
                    ;;
                *)
                    fail "unknown encryption type"
                    ;;
            esac
            ;;
        no)
            FINAL_ARCHIVE_NAME="$COMPRESSED_ARCHIVE_NAME"
            ;;
        *)
            fail "unknown encryption setting"
            ;;
    esac

    FINAL_ARCHIVE="$WORK_DIR/$FINAL_ARCHIVE_NAME"
}

create_tar() {
    log "creating tar archive"
    tar -C "$STAGING_DIR" -cf "$TAR_ARCHIVE" . || fail "tar archive failed"
}

compress_archive() {
    case "$COMPRESSION_TYPE" in
        zstd)
            log "compressing archive with zstd"
            zstd $ZSTD_FLAGS -q -o "$COMPRESSED_ARCHIVE" "$TAR_ARCHIVE" || fail "compression failed"
            ;;
        *)
            fail "unknown compression type"
            ;;
    esac

    rm -f "$TAR_ARCHIVE" || fail "could not remove plain tar"
}

encrypt_archive() {
    case "$ENCRYPT_BACKUP" in
        yes)
            case "$ENCRYPTION_TYPE" in
                age)
                    log "encrypting archive with age"
                    age -r "$AGE_PUBLIC_KEY" -o "$FINAL_ARCHIVE" "$COMPRESSED_ARCHIVE" || fail "encryption failed"
                    rm -f "$COMPRESSED_ARCHIVE" || fail "could not remove unencrypted archive"
                    ;;
                *)
                    fail "unknown encryption type"
                    ;;
            esac
            ;;
        no)
            FINAL_ARCHIVE="$COMPRESSED_ARCHIVE"
            FINAL_ARCHIVE_NAME="$COMPRESSED_ARCHIVE_NAME"
            ;;
        *)
            fail "unknown encryption setting"
            ;;
    esac
}

package_archive() {
    set_archive_names
    create_tar
    compress_archive
    encrypt_archive
}

prune_r2() {
    remote_path=$1

    if [ "$REMOTE_RETENTION_ENABLED" != "yes" ]; then
        log "remote retention disabled"
        return 0
    fi

    log "pruning old r2 archives"
    rclone delete "$remote_path" --min-age "${RETENTION_DAYS}d" || fail "r2 prune failed"
}

dispatch_r2() {
    remote_path="$RCLONE_REMOTE/$HOSTNAME_VALUE/$APP_NAME/"

    log "copying archive to r2"
    rclone copy "$FINAL_ARCHIVE" "$remote_path" || fail "r2 upload failed"

    prune_r2 "$remote_path"
}

dispatch_local() {
    log "copying archive to local destination"
    mkdir -p "$LOCAL_DEST_DIR" || fail "could not create local destination"
    mv "$FINAL_ARCHIVE" "$LOCAL_DEST_DIR/$FINAL_ARCHIVE_NAME" || fail "local archive move failed"
}

dispatch_archive() {
    case "$BACKUP_DEST_TYPE" in
        r2)
            dispatch_r2
            ;;
        local)
            dispatch_local
            ;;
        *)
            fail "unknown destination type"
            ;;
    esac
}

main() {
    validate_config
    check_commands
    prepare_work_dirs
    acquire_lock
    stage_data
    package_archive
    dispatch_archive
    notify_success
    log "backup completed, $FINAL_ARCHIVE_NAME"
}

main "$@"
