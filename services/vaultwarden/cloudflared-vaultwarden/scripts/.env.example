# source app data directory
DATA_DIR=/opt/example-app/data

# short app name used in archive names
APP_NAME=exampleapp

# backup target, use r2 or local
BACKUP_DEST_TYPE=local

# rclone remote and bucket path, used when target is r2
RCLONE_REMOTE=r2:example-backups

# local hoover directory, used when target is local
LOCAL_DEST_DIR=/mnt/backup-hoover/exampleapp

# compression type, currently zstd
COMPRESSION_TYPE=zstd

# zstd compression flags
ZSTD_FLAGS='-12'

# encrypt backups, use yes or no
ENCRYPT_BACKUP=yes

# encryption type, currently age
ENCRYPTION_TYPE=age

# age public key, used when encryption is enabled
AGE_PUBLIC_KEY=age1examplepublickeyreplacewithrealkey

# optional healthchecks url, leave empty to disable pings
HEALTHCHECKS_URL=

# remote retention, use yes only when the r2 token can delete objects
REMOTE_RETENTION_ENABLED=no

# r2 retention in days, used when remote retention is enabled
RETENTION_DAYS=30

# optional relative path patterns to skip, separated by spaces
EXCLUDE_PATTERNS='tmp tmp/* cache cache/* logs logs/* node_modules node_modules/*'

# backup lock, use yes or no
LOCK_ENABLED=yes

# optional lock directory, leave empty for the default
LOCK_DIR=

# rclone name
RCLONE_NAME="rclone-remote-name"

# rclone type
RCLONE_TYPE="s3"

# rclone provider
RCLONE_PROVIDER="Cloudflare"

# rclone access_key_id
RCLONE_ACCESS_KEY_ID="the_access_key_for_the_api_key_being_used"

# rclone secret_access_key
RCLONE_SECRET_ACCESS_KEY="the_secret_access_key"

# rclone endpoint
RCLONE_ENDPOINT='https://account_s3_id.r2.cloudflarestorage.com'

# rclone no_check_bucket
RCLONE_NO_CHECK_BUCKET="true"
