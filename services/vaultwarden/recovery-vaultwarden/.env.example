VAULTWARDEN_IMAGE=vaultwarden/server:latest
VAULTWARDEN_CONTAINER_NAME=vaultwarden-recovery
VAULTWARDEN_DOMAIN=https://vault.example.com
VAULTWARDEN_ADMIN_TOKEN=
VAULTWARDEN_LOCAL_PORT=8180

# The path inside the Restic snapshot. This must match the path used by the
# daily SQLite backup job.
RESTIC_SQLITE_PATH=/vaultwarden/db.sqlite3

COMPOSE_CMD=docker compose
