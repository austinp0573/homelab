# copy to .env, set the required values, then chmod 600 .env

# rpi-openssh or rpi-dropbear
PROFILE=rpi-dropbear

ARCH=arm64
HOSTNAME=rpi-node
TIMEZONE=America/Chicago
LOCALE=en_US.UTF-8
ENSURE_PACKAGES="curl htop fastfetch"
APT_INSTALL_RECOMMENDS=n

# required: use a password or admin SSH keys
ADMIN_USER=austin
ADMIN_PASSWORD=
ADMIN_GROUPS="sudo video gpio"
ROOT_SSH_KEYS=
ADMIN_SSH_KEYS=
SAME_SSH_KEYS=n

# safe defaults for Raspberry Pi OS
MANAGE_NETWORK=n
MANAGE_DNS=n
DNS_SERVERS="1.1.1.1 1.0.0.1 9.9.9.9 8.8.8.8"

ENABLE_IPV6=y
# IPV6_FORWARDING options: y (always enable), n (always disable), prompt (ask interactively)
IPV6_FORWARDING=y

JOURNAL_TO_RAM=y
JOURNAL_SYSTEM_MAX_USE=200M
KEEP_RSYSLOG=n
AUTO_SECURITY_UPDATES=y

ZRAM=y
ZRAM_SIZE_PERCENT=50
ZRAM_ALGORITHM=zstd
SWAPFILE=y
SWAPFILE_PATH=/swapfile
SWAPFILE_SIZE=4G

OPTIONAL_RUN=
OPTIONAL_PROMPT=y

# nftables hardening
NFT_SSH_PORT=22
NFT_EXTRA_TCP_PORTS=
NFT_EXTRA_UDP_PORTS=
NFT_ALLOW_TAILSCALE=n
NFT_TAILSCALE_FORWARD=n

# nerdctl (arm64 default)
NERDCTL_VERSION=2.3.5
NERDCTL_ARCH=arm64
NERDCTL_SHA256=6e4b687f1d138e750a3c8372abc0f81d3d7490b6359c48c0562fc7dfe98859b2

# tailscale
TAILSCALE_AUTH_KEY=
TAILSCALE_HOSTNAME=
TAILSCALE_ADVERTISE_ROUTES=
TAILSCALE_ADVERTISE_EXIT_NODE=n
