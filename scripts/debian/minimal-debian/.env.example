# copy to .env, set the required values, then chmod 600 .env

# cloud-openssh, cloud-dropbear, proxmox-openssh, or proxmox-dropbear
PROFILE=cloud-dropbear

ARCH=amd64
HOSTNAME=debian-1
TIMEZONE=America/Chicago
LOCALE=en_US.UTF-8
ENSURE_PACKAGES="curl htop fastfetch"
APT_INSTALL_RECOMMENDS=n

# required: use a password or admin SSH keys
ADMIN_USER=
ADMIN_PASSWORD=
ADMIN_GROUPS=sudo
ROOT_SSH_KEYS=
ADMIN_SSH_KEYS=
SAME_SSH_KEYS=n

# profile values can be overridden here when needed
# DROPBEAR_SSH=y
# QEMU_GUEST_AGENT=y
# PURGE_CLOUD_INIT=y
# MANAGE_NETWORK=y
# MANAGE_DNS=y
# DNS_SERVERS="1.1.1.1 1.0.0.1"

JOURNAL_TO_RAM=n
JOURNAL_SYSTEM_MAX_USE=50M
KEEP_RSYSLOG=n
AUTO_SECURITY_UPDATES=y

ZRAM=y
ZRAM_SIZE_PERCENT=50
ZRAM_ALGORITHM=lz4
SWAPFILE=y
SWAPFILE_PATH=/swapfile
SWAPFILE_SIZE=2G

OPTIONAL_RUN=
OPTIONAL_PROMPT=y

# nftables hardening
NFT_SSH_PORT=22
NFT_EXTRA_TCP_PORTS=
NFT_EXTRA_UDP_PORTS=
NFT_ALLOW_TAILSCALE=n
NFT_TAILSCALE_FORWARD=n

# haproxy
HAPROXY_FULL_SETUP=n
HAPROXY_EMAIL=
HAPROXY_DOMAINS=

# nerdctl
NERDCTL_VERSION=2.3.5
NERDCTL_ARCH=amd64
NERDCTL_SHA256="b697295c623639734aaab737523c808fd3cc8d3046039fd94fff1744e4c317aa"

# headscale
HEADSCALE_VERSION=0.29.2
HEADSCALE_ARCH=
HEADSCALE_SHA256=
HEADSCALE_URL=
HEADSCALE_SERVER_URL=
HEADSCALE_MAGICDNS_BASE=
HEADSCALE_MAGICDNS_ENABLED=true
HEADSCALE_LISTEN_ADDR=127.0.0.1:8080

# tailscale
TAILSCALE_AUTH_KEY=
TAILSCALE_HOSTNAME=
TAILSCALE_ADVERTISE_ROUTES=
TAILSCALE_ADVERTISE_EXIT_NODE=n

# headscale bootstrap
HEADSCALE_BOOTSTRAP_USER=edge
HEADSCALE_BOOTSTRAP_KEY_OUT=/root/headscale-preauth.key
HEADSCALE_BOOTSTRAP_EXPIRATION=90d
HEADSCALE_BOOTSTRAP_REUSABLE=y
