# copy to .env, set the required values, then chmod 600 .env

ARCH=amd64
LOCALE=en_US.UTF-8
APT_INSTALL_RECOMMENDS=n

# packages to install (space-separated list)
ENSURE_PACKAGES="curl htop fastfetch"

# zram / swap
ZRAM=y
ZRAM_SIZE_PERCENT=50
ZRAM_ALGORITHM=lz4
SWAPFILE=y
SWAPFILE_PATH=/swapfile
SWAPFILE_SIZE=2G

# optional scripts execution control
# space-separated list of optional scripts to run automatically, or 'all', or empty to prompt
OPTIONAL_RUN=
OPTIONAL_PROMPT=y

# nerdctl-full (containerd, nerdctl, buildkit, cni)
NERDCTL_VERSION=2.3.5
NERDCTL_ARCH=amd64
NERDCTL_SHA256="b697295c623639734aaab737523c808fd3cc8d3046039fd94fff1744e4c317aa"
